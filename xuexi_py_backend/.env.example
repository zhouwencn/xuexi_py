APP_ENV=development
POSTGRES_DB=xuexi_py
POSTGRES_USER=xuexi_py
POSTGRES_PASSWORD=xuexi_py
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://xuexi_py:xuexi_py@localhost:5432/xuexi_py
# 开发环境可省略 AUTH_SECRET_KEY，此时每次启动生成临时随机密钥。
# 生产环境必须取消下一行注释并替换为至少 32 字节的随机值。
# AUTH_SECRET_KEY=replace-with-a-random-production-secret
ACCESS_TOKEN_MINUTES=60
CODE_EXECUTION_ENABLED=false
CODE_RUNNER_IMAGE=python:3.12-alpine
CODE_EXECUTION_TIMEOUT_SECONDS=5
LAB_ENVIRONMENTS_ENABLED=false
LAB_RUNTIME_IMAGE=xuexi-py-lab:latest
LAB_ENVIRONMENT_TTL_MINUTES=60
FRONTEND_ORIGINS=["http://localhost:5173"]
