POSTGRES_DB=xuexi_py
POSTGRES_USER=xuexi_py
POSTGRES_PASSWORD=xuexi_py
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://xuexi_py:xuexi_py@localhost:5432/xuexi_py
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=60
